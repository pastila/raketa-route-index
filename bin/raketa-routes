#!/usr/bin/env bash
# Terminal twin of the plugin.
#   raketa-routes dump [raketa-dir]         rebuild <raketa-dir>/.idea/raketa-routes.json
#   raketa-routes find <url|command|text> [raketa-dir]  print matching routes and console commands, best first
# raketa-dir defaults to the current git root. Container: $RAKETA_PHP_CONTAINER (raketa-php).
set -euo pipefail

HERE="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
DUMPER="$HERE/src/main/resources/dumper/dump-routes.php"
CONTAINER="${RAKETA_PHP_CONTAINER:-raketa-php}"

cmd="${1:-}"; shift || true
case "$cmd" in
    dump)
        root="$(realpath "${1:-$(git rev-parse --show-toplevel)}")"
        out="$root/.idea/raketa-routes.json"
        mkdir -p "$root/.idea"
        docker exec -i "$CONTAINER" php -d xdebug.mode=off -- < "$DUMPER" > "$out.tmp"
        mv "$out.tmp" "$out"
        # Failures go last and fail the command: a half-empty index is easy to miss in the stderr above.
        python3 -c "
import json, sys
d = json.load(open(sys.argv[1]))
print(len(d['routes']), 'routes', d['apps'])
print(len(d.get('commands', [])), 'commands', d.get('consoles'))
failed = d.get('failed') or {}
for name, reason in failed.items():
    print('\033[31mNOT COLLECTED ' + name + ': ' + reason + '\033[0m', file=sys.stderr)
sys.exit(1 if failed else 0)
" "$out"
        ;;
    find)
        query="${1:?usage: raketa-routes find <url|command|text> [raketa-dir]}"
        root="$(realpath "${2:-$(git rev-parse --show-toplevel)}")"
        python3 "$HERE/bin/find_routes.py" "$root/.idea/raketa-routes.json" "$query"
        ;;
    *)
        sed -n '2,6p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
